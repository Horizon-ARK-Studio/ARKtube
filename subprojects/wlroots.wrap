[wrap-git]
url = https://gitlab.freedesktop.org/wlroots/wlroots.git
revision = 0.20.2
depth = 1

# meson.build's dependency('wlroots-0.20', fallback: ['wlroots', 'wlroots'])
# only reaches this subproject at all if pkg-config can't find a
# wlroots-0.20.pc on the system first. Ubuntu Noble's (and most current
# stable distros') libwlroots-dev package is still 0.17.x -- a
# pkg-config name of wlroots-0.17, not wlroots-0.20 -- so that lookup
# fails there and meson falls back to cloning and building this
# instead. That's expected and fine: it's exactly what the fallback is
# for, and this is also how upstream Cage itself carries the same
# dependency() call with no shipped wrap of its own -- their CI happens
# to run on a system with 0.20 already installed, which most people
# testing this branch today won't have. Requires network access on the
# machine running `meson setup` (a one-time ~60MB clone); after that
# it's cached in build/subprojects/wlroots and not re-fetched on
# subsequent builds unless removed.
#
# 0.20.2 is the latest 0.20.x point release at the time this was
# pinned. Bump the revision here (and re-run `meson setup --wipe`) if a
# later 0.20.x point release fixes something you need; there is no
# reason this needs to track wlroots' main branch.

[provide]
wlroots = wlroots
