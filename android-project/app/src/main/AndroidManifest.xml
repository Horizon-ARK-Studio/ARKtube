<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Unlike an assets-bundled WebView shell, ARKtube's whole point
         (see the desktop app's docs/PROBLEM-STATEMENT.md) is to wrap
         the *live* youtube.com/m.youtube.com in a native shell rather
         than ship a bundled copy of it - so this needs real network
         access, not just a local asset loader. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets MediaPlaybackService run as a foreground service while
         video is actually playing - required for the OS to treat its
         MediaSessionCompat/notification as a genuine active media
         session that the lock screen, Bluetooth AVRCP devices, and
         wired headset buttons can address. FOREGROUND_SERVICE_MEDIA_PLAYBACK
         (API 34+) is the specific typed variant startForeground()
         declares itself as there; FOREGROUND_SERVICE covers older
         API levels that don't require a type-specific permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Only gates whether the media notification itself can be
         *shown* on Android 13+ - MediaSessionCompat, and therefore
         lock-screen/Bluetooth/wired transport control, works with or
         without this being granted. Requested at runtime in
         MainActivity.onCreate(). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ArkTubeApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.ArkTubeApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ArkTubeApp.Starting">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hosts the MediaSessionCompat/notification for OS-level
             play/pause/seek transport control - see
             MediaPlaybackService's own class doc. The MEDIA_BUTTON
             intent-filter is what lets MediaButtonReceiver.
             buildMediaButtonPendingIntent() (used for the
             notification's own transport buttons, and by the system
             for wired-headset/Bluetooth AVRCP key events) resolve to
             this service; android:exported="true" is required for a
             component with an intent-filter under targetSdk 34, and
             matches how those external button-press intents actually
             need to reach it. -->
        <service
            android:name=".MediaPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>
    </application>
</manifest>
