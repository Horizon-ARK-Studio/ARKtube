#!/usr/bin/env bash
#
# AppRun - AppImage entrypoint for ARKtube.
#
# Three jobs, all documented in docs/BUGS-CAUGHT.md:
#
#   1. Point Neutralino's NL_PATH at a writable directory instead of the
#      read-only squashfs mount, so its internal ".tmp" working-storage
#      directory can actually be created (avoids the
#      "filesystem error: cannot create directories: Read-only file
#      system [./.tmp]" abort).
#   2. Make sure GPU compositing / accelerated video decode aren't
#      silently disabled, so WebKitGTK's playback quality matches what
#      Firefox gets on the same machine.
#   3. Make sure the Chrome-mode browser process is actually cleaned up
#      when the app closes, and that a leftover instance from a previous
#      unclean shutdown doesn't silently hijack the next launch instead
#      of starting fresh ("Opening in existing browser session.").
#
set -euo pipefail

HERE="$(dirname "$(readlink -f "${0}")")"

# --- 1. Writable NL_PATH -----------------------------------------------
# XDG_DATA_HOME/ARKtube is created on first run if it doesn't exist yet.
# Passing this via --path overrides NL_PATH inside the Neutralino binary,
# so ./.tmp resolves under here instead of under the read-only AppImage
# mount point ($HERE, which is /tmp/.mount_XXXXXXX/... at runtime).
DATA_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}"
ARKTUBE_DATA_DIR="${DATA_HOME}/ARKtube"
mkdir -p "${ARKTUBE_DATA_DIR}"

# --- 2. Hardware-accelerated playback -----------------------------------
# Unset anything inherited from the host environment that would force
# software-only rendering.
unset WEBKIT_DISABLE_COMPOSITING_MODE || true
unset LIBGL_ALWAYS_SOFTWARE || true

# Keep WebKit's accelerated DMA-BUF video frame path enabled instead of
# falling back to the slower Cairo path.
export WEBKIT_DISABLE_DMABUF_RENDERER=0

# GStreamer's VA-API plugin only trusts a short hardcoded driver
# allow-list by default; this is the most common reason "VA-API is
# installed but not used" outside a handful of Intel chips.
export GST_VAAPI_ALL_DRIVERS=1

# LIBVA_DRIVER_NAME is deliberately NOT set here - forcing the wrong
# value (e.g. iHD on an AMD/NVIDIA machine) breaks VA-API outright
# instead of just leaving it unaccelerated. If a value is already set in
# the environment (e.g. by the user, matching what they use for Firefox
# or mpv), it's left alone and simply inherited below.

# --- 3. Chrome-mode process lifecycle ------------------------------------
# Neutralino's chrome mode (chrome.cpp) always launches Chrome/Chromium
# against "${ARKTUBE_DATA_DIR}/.tmp/chromedata" as its --user-data-dir -
# that's Neutralino's own unconditional internal default, not something
# this project configures, and thanks to job 1 above it's already a
# persistent path. Cookies/session state already survive between launches
# on their own; nothing needs adding to neutralino.config.json for that.
#
# The actual problem is that Neutralino spawns Chrome as a fully-detached
# background process (TinyProcessLib::Process, which calls setpgid(0, 0)
# on Linux - see lib/tinyprocess/process_unix.cpp upstream), so it is
# NOT part of this script's or the Neutralino binary's process group, and
# app::exit()/app.killProcess() only ever signal the Neutralino server's
# own PID (api/app/app.cpp), never Chrome's. If ARKtube closes uncleanly
# (Ctrl-C, a window-manager force-quit, a crash) the Chrome process and
# its profile lock (SingletonLock/SingletonSocket/SingletonCookie under
# .tmp/chromedata) are orphaned. The next launch then hits Chrome's own
# singleton-instance check, hands off to that orphan, and prints
# "Opening in existing browser session." instead of starting fresh -
# which also means that window was never wired to *this* run's
# app-init.js close handling, and orphans keep piling up across runs.
#
# CHROME_LOCK_PATTERN is unique to this app's own dedicated profile
# directory (under our own XDG_DATA_HOME/ARKtube, never the user's real
# browser profile), so matching on it can't touch any other Chrome
# window the user has open.
CHROME_PROFILE_DIR="${ARKTUBE_DATA_DIR}/.tmp/chromedata"
CHROME_LOCK_PATTERN="--user-data-dir=${CHROME_PROFILE_DIR}"

reap_stale_chrome() {
    if command -v pgrep >/dev/null 2>&1; then
        local pids
        pids="$(pgrep -f -- "${CHROME_LOCK_PATTERN}" 2>/dev/null || true)"
        if [ -n "${pids}" ]; then
            echo "ARKtube: cleaning up a leftover browser process from a previous run..." >&2
            # shellcheck disable=SC2086
            kill -TERM ${pids} 2>/dev/null || true
            sleep 1
            # shellcheck disable=SC2086
            kill -KILL ${pids} 2>/dev/null || true
        fi
    fi
    # A crashed/hard-killed process can leave these lock files behind with
    # no live PID holding them - Chrome treats their mere presence as
    # "another instance owns this profile" and refuses to start cleanly,
    # so clear them unconditionally once we've made sure nothing's using them.
    rm -f "${CHROME_PROFILE_DIR}/SingletonLock" \
          "${CHROME_PROFILE_DIR}/SingletonSocket" \
          "${CHROME_PROFILE_DIR}/SingletonCookie" 2>/dev/null || true
}

# Clean up anything the *previous* run left behind before we start.
reap_stale_chrome

# And clean up after *this* run however it ends, so the next launch
# doesn't inherit the problem.
trap reap_stale_chrome EXIT INT TERM

"${HERE}/ARKtube" --path="${ARKTUBE_DATA_DIR}" "$@"
