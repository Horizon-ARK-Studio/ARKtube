#!/usr/bin/env bash
#
# AppRun - AppImage entrypoint for ARKtube.
#
# Three jobs, all documented in docs/BUGS-CAUGHT.md:
#
#   1. Point Neutralino's NL_PATH at a writable directory instead of the
#      read-only squashfs mount, so its internal ".tmp" working-storage
#      directory can actually be created (avoids the
#      "filesystem error: cannot create directories: Read-only file
#      system [./.tmp]" abort).
#   2. Make sure GPU compositing / accelerated video decode aren't
#      silently disabled, so WebKitGTK's playback quality matches what
#      Firefox gets on the same machine.
#   3. Launch Neutralino (window mode) and packaging/linux/embed-chrome.sh
#      (which spawns Chrome and reparents it into Neutralino's window)
#      together as one unit, so closing either one closes both, and a
#      leftover Chrome instance from a previous unclean shutdown doesn't
#      silently hijack the next launch instead of starting fresh
#      ("Opening in existing browser session.").
#
set -euo pipefail

HERE="$(dirname "$(readlink -f "${0}")")"

# --- 1. Writable NL_PATH -----------------------------------------------
# XDG_DATA_HOME/ARKtube is created on first run if it doesn't exist yet.
# Passing this via --path overrides NL_PATH inside the Neutralino binary,
# so ./.tmp resolves under here instead of under the read-only AppImage
# mount point ($HERE, which is /tmp/.mount_XXXXXXX/... at runtime).
DATA_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}"
ARKTUBE_DATA_DIR="${DATA_HOME}/ARKtube"
mkdir -p "${ARKTUBE_DATA_DIR}"

# --- 2. Hardware-accelerated playback -----------------------------------
# Unset anything inherited from the host environment that would force
# software-only rendering.
unset WEBKIT_DISABLE_COMPOSITING_MODE || true
unset LIBGL_ALWAYS_SOFTWARE || true

# Keep WebKit's accelerated DMA-BUF video frame path enabled instead of
# falling back to the slower Cairo path.
export WEBKIT_DISABLE_DMABUF_RENDERER=0

# GStreamer's VA-API plugin only trusts a short hardcoded driver
# allow-list by default; this is the most common reason "VA-API is
# installed but not used" outside a handful of Intel chips.
export GST_VAAPI_ALL_DRIVERS=1

# LIBVA_DRIVER_NAME is deliberately NOT set here - forcing the wrong
# value (e.g. iHD on an AMD/NVIDIA machine) breaks VA-API outright
# instead of just leaving it unaccelerated. If a value is already set in
# the environment (e.g. by the user, matching what they use for Firefox
# or mpv), it's left alone and simply inherited below.

# --- 3. Hybrid mode: Chrome embedded inside Neutralino's own window ------
# ARKtube's defaultMode is now "window" (see neutralino.config.json) -
# Neutralino owns the real, WM-managed top-level window and loads only a
# small local backdrop page. YouTube itself is rendered by a real,
# separately-spawned Chrome process that packaging/linux/embed-chrome.sh
# reparents as an X11 child of that window and keeps resized to match it.
# That script is also what grabs F11/Escape/Home globally, so they always
# resolve against Neutralino's window rather than whichever window
# (usually the embedded Chrome, since it fills the whole screen) currently
# has input focus.
#
# Chrome is spawned directly by embed-chrome.sh now, not via Neutralino's
# own chrome mode (chrome.cpp) - chrome.cpp only ever launches Chrome as a
# fully-detached process it has no further control over, which is
# incompatible with reparenting it into another window mid-launch. That
# also means the detached-process/orphan-profile-lock problem this section
# used to describe for chrome.cpp's spawn no longer applies the same way -
# embed-chrome.sh's own trap (below and inside the script itself) is what
# now guarantees Chrome exits alongside Neutralino - but CHROME_LOCK_PATTERN
# is kept for the same reason as before: a crashed/hard-killed previous run
# can still leave Chrome's SingletonLock/SingletonSocket/SingletonCookie
# behind under its profile dir, which makes the *next* launch silently hand
# off to an orphaned instance instead of starting fresh.
CHROME_PROFILE_DIR="${ARKTUBE_DATA_DIR}/.tmp/chromedata"
CHROME_LOCK_PATTERN="--user-data-dir=${CHROME_PROFILE_DIR}"

reap_stale_chrome() {
    if command -v pgrep >/dev/null 2>&1; then
        local pids
        pids="$(pgrep -f -- "${CHROME_LOCK_PATTERN}" 2>/dev/null || true)"
        if [ -n "${pids}" ]; then
            echo "ARKtube: cleaning up a leftover browser process from a previous run..." >&2
            # shellcheck disable=SC2086
            kill -TERM ${pids} 2>/dev/null || true
            sleep 1
            # shellcheck disable=SC2086
            kill -KILL ${pids} 2>/dev/null || true
        fi
    fi
    # A crashed/hard-killed process can leave these lock files behind with
    # no live PID holding them - Chrome treats their mere presence as
    # "another instance owns this profile" and refuses to start cleanly,
    # so clear them unconditionally once we've made sure nothing's using them.
    rm -f "${CHROME_PROFILE_DIR}/SingletonLock" \
          "${CHROME_PROFILE_DIR}/SingletonSocket" \
          "${CHROME_PROFILE_DIR}/SingletonCookie" 2>/dev/null || true
}

# Clean up anything the *previous* run left behind before we start.
reap_stale_chrome

# And clean up after *this* run however it ends, so the next launch
# doesn't inherit the problem.
trap reap_stale_chrome EXIT INT TERM

# --- Immersive Mode: real Chrome-side hardening -------------------------
# resources/js/app-init.js's Immersive Mode button persists its on/off
# state via Neutralino.storage, a plain file at
# ${ARKTUBE_DATA_DIR}/.storage/<key>.neustorage; this script reads that
# same file directly and decides whether embed-chrome.sh gets the
# --immersive flag for this launch (real Chrome flags can only be decided
# at Chrome's own process start, not mid-session).
IMMERSIVE_FLAG_FILE="${ARKTUBE_DATA_DIR}/.storage/immersiveMode.neustorage"
IMMERSIVE_ARG=""
if [ -f "${IMMERSIVE_FLAG_FILE}" ] && [ "$(cat "${IMMERSIVE_FLAG_FILE}" 2>/dev/null)" = "1" ]; then
    IMMERSIVE_ARG="--immersive"
fi

# --- Launch Neutralino (the real, WM-managed window) ---------------------
"${HERE}/ARKtube" --path="${ARKTUBE_DATA_DIR}" "$@" &
NEUTRALINO_PID=$!

# --- Launch and embed Chrome inside it ------------------------------------
# Give Neutralino's window a moment to actually exist before
# embed-chrome.sh starts searching for it by title.
sleep 1
"${HERE}/embed-chrome.sh" "ARKtube" "https://www.youtube.com/tv#/" \
    "${CHROME_PROFILE_DIR}" "${IMMERSIVE_ARG}" &
EMBED_PID=$!

# --- Close-button lifecycle coupling -------------------------------------
# Chrome is now spawned by embed-chrome.sh, as a plain child of this
# script rather than a fully-detached process Neutralino owns, so unlike
# the old chrome-mode setup, killing this script's process group is
# already enough to take Chrome down with it in the common case. This
# loop covers the two directions that alone wouldn't: (a) the user closes
# Neutralino's own window/quits from the tray -- nothing else would tell
# Chrome (or embed-chrome.sh) to exit, since it never spawned Neutralino
# and has no other path back to it; (b) the embedded Chrome window is
# killed/crashes on its own -- with no visible content left, Neutralino's
# now-empty backdrop window should not linger either.
while kill -0 "${NEUTRALINO_PID}" 2>/dev/null; do
    if ! kill -0 "${EMBED_PID}" 2>/dev/null && ! pgrep -f -- "${CHROME_LOCK_PATTERN}" >/dev/null 2>&1; then
        kill -TERM "${NEUTRALINO_PID}" 2>/dev/null || true
        break
    fi
    sleep 1
done

kill -TERM "${EMBED_PID}" 2>/dev/null || true
wait "${NEUTRALINO_PID}" 2>/dev/null || true
