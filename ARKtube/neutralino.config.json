{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.arktube.app",
  "version": "0.1.0",
  "defaultMode": "chrome",
  "port": 0,
  "documentRoot": null,
  "url": "https://www.youtube.com/tv#/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.exit",
    "app.killProcess",
    "debug.log",
    "os.setTray",
    "os.showMessageBox",
    "events.broadcast"
  ],
  "modes": {
    "window": {
      "title": "ARKtube",
      "width": 1280,
      "height": 720,
      "minWidth": 960,
      "minHeight": 540,
      "center": true,
      "fullScreen": true,
      "alwaysOnTop": false,
      "icon": "/resources/icons/appIcon.png",
      "enableInspector": true,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": false,
      "injectGlobals": true,
      "injectClientLibrary": true,
      "injectScript": "/resources/js/app-init.js",
      "extendUserAgentWith": " Mozilla/5.0 (PS4; Leanback Shell) Cobalt/26.lts.0-qa; compatible;"
    },
    "browser": {
      "globalVariables": {
        "TEST": "Test value browser"
      },
      "nativeBlockList": [
        "filesystem.*"
      ]
    },
    "cloud": {
      "url": "/resources/#cloud",
      "nativeAllowList": [
        "app.*"
      ]
    },
    "chrome": {
      "width": 1280,
      "height": 720,
      "args": "--user-agent=\"Mozilla/5.0 (PS4; Leanback Shell) Cobalt/26.lts.0-qa; compatible;\" --start-maximized",
      "browserBinaryDarwin": "/Applications/Google Chrome.app",
      "injectScript": "/resources/js/app-init.js",
      "nativeBlockList": [
        "filesystem.*"
      ],
      "nativeAllowList": [
        "app.exit",
        "app.killProcess",
        "debug.log",
        "os.setTray",
        "os.showMessageBox",
        "events.broadcast"
      ]
    }
  },
  "cli": {
    "binaryName": "ARKtube",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.8.0",
    "clientVersion": "6.8.0"
  }
}
