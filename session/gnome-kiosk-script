#!/bin/sh
#
# gnome-kiosk-script — deployed to ~/.local/bin/gnome-kiosk-script.
#
# This is the exact, and only, file the `gnome-kiosk-script-session`
# package (Ubuntu/GDM) leaves unfilled. Everything else — the GDM gear
# entry, the gnome-session session file, and the systemd user service
# that runs this script — is already shipped by that package. See
# docs/STAGE-1-SELECTABLE-SESSION.md for how that was verified.
#
# `/usr/bin/gnome-kiosk-script` (from the package) execs this file with
# `exec ~/.local/bin/gnome-kiosk-script "$@"` if it exists, instead of
# writing out its own placeholder example. So this script *is* the
# kiosk's managed application, from GNOME Kiosk's point of view.
#
# `arktube` is the launcher a .deb install of ARKtube puts on PATH
# (see main's packaging/linux/build-deb.sh) — it already handles
# NL_PATH, stale-Chrome cleanup, and its own EXIT/INT/TERM trap, so
# nothing further needs to happen here.
#
# No respawn logic here on purpose: the systemd unit that runs this
# script (org.gnome.Kiosk.Script.service) already has Restart=always,
# so if ARKtube exits, this script exiting will cause a relaunch loop
# regardless of what's written here. Taming that loop, and making
# ARKtube exit actually end the session instead of relaunching it, is
# Stage 2's job — see the "GNOME Kiosk 46 vs 50" note in
# docs/STAGE-1-SELECTABLE-SESSION.md.
#
# Stage 6 (see docs/STAGE-6-OFFLINE-TOPBAR.md) starts the offline system
# topbar here, backgrounded, before the `exec` below. It's launched from
# this script rather than a separate systemd unit or XDG autostart entry
# specifically so it's forked *into this same process*, before that
# process image is replaced by `exec arktube` — meaning it lands in
# org.gnome.Kiosk.Script.service's own cgroup for free, and Stage 4's
# `KillMode=control-group` (session/systemd/.../override.conf) reaps it
# on logout along with everything else, with no second lifecycle to
# maintain. If the topbar isn't installed (e.g. this branch's own
# install script hasn't been re-run since Stage 6 landed), this silently
# does nothing rather than blocking ARKtube from starting.
if [ -x "${HOME}/.local/share/arktube-topbar/topbar.py" ]; then
    python3 "${HOME}/.local/share/arktube-topbar/topbar.py" &
fi

# Stage 7 (see docs/STAGE-7-VISIBILITY-AND-CURSOR.md): hide the mouse
# pointer after 10s of no motion/click, same launch-point-and-cgroup
# reasoning as the topbar above — one more thing forked in before `exec`
# so it rides the same KillMode=control-group cleanup instead of a third
# lifecycle. `--timeout`/`-idle` is seconds of inactivity before the
# cursor is hidden; any motion or click restores it immediately, both
# tools' own default behavior. Guarded by `command -v` the same way the
# topbar check above guards on `-x`, so a machine that hasn't re-run
# this branch's install script since Stage 7 landed still starts
# ARKtube instead of failing on a missing binary.
if command -v unclutter-xfixes >/dev/null 2>&1; then
    unclutter-xfixes --timeout 10 &
elif command -v unclutter >/dev/null 2>&1; then
    # Older/alternate package name on some distros; same CLI shape.
    unclutter -idle 10 -root &
fi

exec arktube
