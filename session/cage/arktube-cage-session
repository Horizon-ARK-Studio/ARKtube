#!/bin/sh
#
# arktube-cage-session — deployed to /usr/local/bin (see
# ../install-arktube-cage-session.sh) and referenced by
# ../wayland-sessions/arktube-cage.desktop's Exec= line as this
# session's actual entry point.
#
# Adapted from ARKtube Webtop's session/gnome-kiosk-script (the GNOME
# Kiosk session's own launch point) for Cage. Same idea -- fork the
# system overlay in before the compositor's client is started, so it
# ends up in this session's own process tree for free -- but the
# surrounding machinery is simpler, because there's one less layer of
# indirection to sit inside of:
#
#   GNOME Kiosk session: GDM -> gnome-session -> gnome-session-binary
#     (as a systemd --user service, org.gnome.Kiosk.Script.service,
#     Restart=always) -> this script -> exec arktube_linux
#
#   Cage session:        GDM -> this script (the session leader
#     directly -- see the .desktop file's Exec=) -> exec cage -- arktube_linux
#
# That directly removes two things ARKtube Webtop's GNOME Kiosk session
# needed and this one doesn't:
#
#   - The org.gnome.Kiosk.Script.service Restart=always override (see
#     ARKtube Webtop's session/systemd/.../override.conf and its own
#     long comment on why Restart=always turned ARKtube exiting into an
#     unremovable relaunch loop under gnome-session-binary). There is no
#     gnome-session-binary here watching a required unit and deciding
#     whether the session should end -- GDM just runs this script, and
#     the session ends when it does. No separate unit to override.
#   - KillMode=control-group for cleanup on logout. Cage's own
#     sigchld_handler() (cage.c) already ends Cage -- and with it, this
#     whole script's process tree, since Cage is exec'd in place of this
#     shell -- the moment its direct child (arktube_linux) exits.
#     Whatever's left in this session's scope (the overlay process
#     forked below) is then systemd-logind's job to clean up when the
#     session scope itself ends, the same guarantee KillMode=control-group
#     was standing in for.
#
# Not yet independently verified end-to-end on a real GDM+logind login
# (see the branch's own staged-verification discipline in
# docs/foundational/STAGED-IMPLEMENTATION.md on the webtop branch) --
# the process-tree reasoning above is sound, but confirming no stray
# overlay process survives a real logout is exactly the kind of thing
# that discipline asks to be checked against the actual system, not
# assumed from this comment.
if [ -x "${HOME}/.local/share/arktube-overlay/overlay.py" ]; then
    python3 "${HOME}/.local/share/arktube-overlay/overlay.py" &
fi

# No X11-cursor-hiding branch here, unlike gnome-kiosk-script: Cage is
# Wayland-only (see cage.1.scd -- there is no Xorg backend to speak of,
# only optional XWayland for the *client's* windows), so the
# `$XDG_SESSION_TYPE = x11` branch that script had for unclutter-xfixes
# has no equivalent session type to trigger on here. Cursor-hiding on
# this session is still arktube_linux's/main's own responsibility (CSS
# `cursor: none` after idle in its injected JS), same as that script's
# comment already says for the Wayland case.
#
# -d: don't draw client-side decorations for arktube_linux's window --
# it's a single fullscreen kiosk app, not a windowed one a title bar
# would ever be useful on. See cage.1.scd's OPTIONS section.
exec cage -d -- arktube_linux
